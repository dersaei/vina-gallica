---
export const prerender = false;
import LayoutDashboard from "../layouts/LayoutDashboard.astro";
import SubmitEditor from "../components/SubmitEditor";
import "../components/ListingForm.css";
import "@mapbox/mapbox-gl-geocoder/dist/mapbox-gl-geocoder.css";

const DIRECTUS_URL = import.meta.env.DIRECTUS_URL;
const DIRECTUS_SERVICE_TOKEN =
  import.meta.env.DIRECTUS_SERVICE_TOKEN ?? import.meta.env.DIRECTUS_STATIC_TOKEN;
const headers = { Authorization: `Bearer ${DIRECTUS_SERVICE_TOKEN}` };

const [wrRes, catRes, deptRes] = await Promise.all([
  fetch(`${DIRECTUS_URL}/items/wine_regions?fields=id,region,color&sort[]=region`, { headers }),
  fetch(`${DIRECTUS_URL}/items/categories_vg?fields=id,name,name_fr,color&sort[]=name`, { headers }),
  fetch(`${DIRECTUS_URL}/items/departments?fields=id,code,name,color,administrative_region.name,administrative_region.color&sort[]=name`, { headers }),
]);
const wineRegions = wrRes.ok ? ((await wrRes.json()) as { data: { id: string; region: string; color?: string | null }[] }).data.map((r) => ({ ...r, color: r.color ?? null })) : [];
const categories = catRes.ok ? ((await catRes.json()) as { data: { id: string; name: string; name_fr?: string | null; color?: string | null }[] }).data.map((c) => ({ ...c, name_fr: c.name_fr ?? null, color: c.color ?? null })) : [];
type DeptRow = { id: string; code: string; name: string; color?: string | null; administrative_region?: { name?: string | null; color?: string | null } | null };
const departments = deptRes.ok ? ((await deptRes.json()) as { data: DeptRow[] }).data.map((d) => ({ id: d.id, code: d.code, name: d.name, color: d.color ?? null, region_name: d.administrative_region?.name ?? null, region_color: d.administrative_region?.color ?? null })) : [];
const mapboxToken = import.meta.env.PUBLIC_MAPBOX_TOKEN;

const firstCat = categories[0];
const someRegions = wineRegions.slice(0, 3);
const sampleListing = {
  id: "demo", Name: "Château Margaux", status: "draft", date_created: null, date_updated: null,
  category: firstCat ? { id: firstCat.id, name: firstCat.name, name_fr: firstCat.name_fr } : null,
  terroir: someRegions.map((r) => ({ wine_regions_id: { id: r.id, region: r.region } })),
  address: "33 Avenue de la Cave", postal_code: "33460", place: "Margaux", phone: null,
  website: "https://chateau-margaux.com",
  location: { type: "Point" as const, coordinates: [-0.668, 45.04] as [number, number] },
  logo: null, description_en: null, description_fr: null, translate_to_en: false, translate_to_fr: false,
  gallery: null, certificates: null, video: null, opening_hours: null, event_date_start: null, event_date_end: null,
  nearest_bus_station_name: null, nearest_bus_station_distance_m: null, nearest_train_station_name: null, nearest_train_station_distance_m: null,
};
---
<LayoutDashboard title="DEV preview" active="submit">
  <script is:inline define:vars={{ mapboxToken }}>window.__MAPBOX_TOKEN__ = mapboxToken;</script>
  <SubmitEditor client:load lang="en" plan="premium" wineRegions={wineRegions} categories={categories} departments={departments} listing={sampleListing} directusUrl={DIRECTUS_URL} />
</LayoutDashboard>
