---
import type { Place, Category, Department, AdministrativeRegion, WineRegion, TerroirJunction, OpeningHour, Slogan } from "../lib/directus.ts";
import { formatEventDateRange } from "../lib/directus.ts";

interface Props {
  place: Place;
  lang?: "en" | "fr";
}

const { place, lang = "en" } = Astro.props;
const isFr = lang === "fr";

/* ---- shared derivations (identical to PlaceCard) ---- */
const eventDates = formatEventDateRange(place.event_date_start, place.event_date_end, lang);

const category = typeof place.category === "object" ? place.category as Category : null;
const dept = typeof place.department === "object" && place.department !== null ? place.department as Department : null;
const region = dept && typeof dept.administrative_region === "object" ? dept.administrative_region as AdministrativeRegion : null;
const wineRegions = (Array.isArray(place.terroir) ? place.terroir : [])
  .map((t) => (t as TerroirJunction).wine_regions_id)
  .filter((wr): wr is WineRegion => typeof wr === "object" && wr !== null);

const regionName = region?.name ?? null;
const regionColor = region?.color ?? null;
const deptName = dept?.name ?? null;
const deptColor = dept?.color ?? null;
const townName = place.place ?? null;

const categoryLabel = isFr
  ? (category?.name_fr ?? category?.name)
  : category?.name;

/* ---- premium derivations ---- */
const websiteLabel = isFr ? "Visiter le site" : "Visit website";
const profileLabel = isFr ? "Voir le profil" : "Visit profile";
const phoneLabel = isFr ? "Téléphone" : "Phone";
const hoursLabel = isFr ? "Horaires" : "Opening hours";

// `place.logo` is a Directus file UUID — build a renderable asset URL.
const logoUrl = place.logo
  ? `${import.meta.env.DIRECTUS_URL}/assets/${place.logo}?width=300&format=webp&quality=85`
  : null;
const phone = place.phone ?? null;
const phoneHref = phone ? `tel:${phone.replace(/[^+\d]/g, "")}` : null;
// Internal Vina Gallica profile link.
const profileHref = place.slug ? `/places/${place.slug}` : "#";

// Slogans — localized list of { text }.
const rawSlogans = (isFr ? place.slogans_fr : place.slogans_en) ?? [];
const slogans = (Array.isArray(rawSlogans) ? rawSlogans : [])
  .map((s) => (s as Slogan)?.text)
  .filter((t): t is string => typeof t === "string" && t.trim().length > 0)
  .slice(0, 3);

// Opening hours — Directus stores an array [{ day, open, close, closed }].
const DAY_LABELS: Record<OpeningHour["day"], { en: string; fr: string }> = {
  mon: { en: "Mon", fr: "Lun" },
  tue: { en: "Tue", fr: "Mar" },
  wed: { en: "Wed", fr: "Mer" },
  thu: { en: "Thu", fr: "Jeu" },
  fri: { en: "Fri", fr: "Ven" },
  sat: { en: "Sat", fr: "Sam" },
  sun: { en: "Sun", fr: "Dim" },
};
const DAY_ORDER: OpeningHour["day"][] = ["mon", "tue", "wed", "thu", "fri", "sat", "sun"];
const closedLabel = isFr ? "Fermé" : "Closed";
const ohSource = Array.isArray(place.opening_hours) ? place.opening_hours : [];
const ohByDay = new Map(ohSource.map((h) => [h.day, h]));
const hours = ohSource.length > 0
  ? DAY_ORDER.map((day) => {
      const h = ohByDay.get(day);
      const label = DAY_LABELS[day];
      const time = !h || h.closed || !h.open || !h.close
        ? closedLabel
        : `${h.open} – ${h.close}`;
      return { day: isFr ? label.fr : label.en, time };
    })
  : [];

const accent = category?.color ?? "#6e2331";
const placeName = place.Name ?? "";

// Festival listings show event dates in place of opening hours.
const isFestival = category
  ? `${category.name} ${category.name_fr ?? ""}`.toLowerCase().includes("festival")
  : false;
const datesLabel = isFr ? "Dates" : "Dates";
---

<article
  class="place-card-premium"
  style={`--pcp-accent: ${accent}`}
  data-category={category?.slug}
  data-wine-region={wineRegions.length > 0 ? wineRegions.map((wr) => wr.slug).join(" ") : undefined}
  data-dept={dept?.slug ?? undefined}
  data-admin-region={region?.slug ?? undefined}
>
  {/* ============ Card — left content + right sidebar (stacks on mobile) ============ */}
  <div class="pcp-web">
    <div class="pcp-main">
      {logoUrl && (
        <div class="pcp-logo pcp-logo--corner">
          <img src={logoUrl} alt={`${placeName} logo`} />
        </div>
      )}

      {category && (
        <div class="pcp-cat-row">
          <span class="pcp-tag" style={`--tag-color: ${category.color}`}>{categoryLabel}</span>
        </div>
      )}

      <h3 class="pcp-name">{placeName}</h3>

      <div class="pcp-info">
        {wineRegions.length > 0 && (
          <div class="pcp-wine">
            {wineRegions.map((wr) => (
              <span style={`--wine-region-color: ${wr.color}`}>{wr.region}</span>
            ))}
          </div>
        )}

        <address class="pcp-address">
          {place.address && <span>{place.address}</span>}
          <span class="pcp-town">
            {place.postal_code && <span>{place.postal_code}</span>}
            {townName && <span>{townName}</span>}
          </span>
        </address>

        <div class="pcp-loc">
          {deptName && <span style={`--loc-color: ${deptColor ?? "#888"}`}>{deptName}</span>}
          {regionName && <span style={`--loc-color: ${regionColor ?? "#888"}`}>{regionName}</span>}
        </div>
      </div>

      {slogans.length > 0 && (
        <ul class="pcp-slogans">
          {slogans.map((s) => <li>{s}</li>)}
        </ul>
      )}
    </div>

    <aside class="pcp-side">
      {phone && (
        <a href={phoneHref} class="pcp-side-phone">
          <span class="pcp-phone-label">{phoneLabel}</span>
          <span class="pcp-phone-num">{phone}</span>
        </a>
      )}

      <div class="pcp-side-actions">
        <a href={profileHref} class="pcp-btn pcp-side-btn">{profileLabel} <span class="arrow">→</span></a>

        {place.website && (
          <a href={place.website} class="pcp-btn pcp-side-btn" target="_blank" rel="noopener noreferrer">{websiteLabel} <span class="arrow">→</span></a>
        )}
      </div>

      {isFestival
        ? (eventDates && (
            <div class="pcp-side-hours">
              <div class="pcp-side-label">{datesLabel}</div>
              <div class="pcp-side-dates">{eventDates}</div>
            </div>
          ))
        : (hours.length > 0 && (
            <div class="pcp-side-hours">
              <div class="pcp-side-label">{hoursLabel}</div>
              <div class="pcp-side-hours-list">
                {hours.map((h) => (
                  <div><span class="pcp-day">{h.day}</span><span class="pcp-time">{h.time}</span></div>
                ))}
              </div>
            </div>
          ))}
    </aside>
  </div>
</article>

<style>
  .place-card-premium {
    /* component-scoped tokens — reuse global ones where they exist */
    --pcp-cream: #fffaf3;
    --pcp-ink: #211e1b;
    --pcp-ink2: var(--color-elegant-black, #2b2926);
    --pcp-sand: var(--color-sand, #e7d8bf);
    --pcp-line: #42403c;
    --pcp-muted: #6f6a62;
    --pcp-accent: #6e2331;
    display: block;
  }

  /* ---------- shared ---------- */
  .pcp-tag {
    display: inline-block;
    font-family: var(--font-label);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--pcp-cream);
    background: var(--tag-color, var(--pcp-accent));
    border: 1px solid #000;
    border-radius: 3px;
    padding: 0.5em 0.6em 0;
    box-shadow: 1px 1px 3px 1px rgba(0, 0, 0, 0.2);
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.5);
  }

  .pcp-name {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 5vw;
    line-height: 1.08;
    color: var(--pcp-ink);
    margin: 0.2em 0 0;
    text-wrap: balance;
    /* Wrap only between words — never split a word mid-letter. */
    word-break: keep-all;
    overflow-wrap: normal;
    hyphens: none;
  }

  .pcp-event {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    font-family: var(--font-label);
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    line-height: 1.1;
    background: var(--pcp-sand);
    color: var(--pcp-ink2);
    border: 1px solid #000;
    border-radius: 3px;
    padding: 0.35em 0.5em 0.1em;
    box-shadow: 1px 1px 3px 1px rgba(0, 0, 0, 0.3);
  }

  /* Logo fits inside a box, preserving its own aspect ratio — works for
     horizontal, square or vertical logos uploaded by producers. */
  .pcp-logo img {
    display: block;
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }
  .pcp-logo-ph {
    display: flex;
    width: 150px;
    height: 60px;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--pcp-line);
    background-image: repeating-linear-gradient(45deg, rgba(33, 30, 27, 0.07) 0 7px, transparent 7px 14px);
    font-family: monospace;
    font-size: 9px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--pcp-line);
  }
  .pcp-logo-ph--lg { width: 170px; height: 62px; }

  .pcp-wine {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
  }
  .pcp-wine span {
    font-family: var(--font-extra);
    font-size: 1.5rem;
    letter-spacing: 0.04em;
    color: var(--pcp-ink);
    border-bottom: 2px solid var(--wine-region-color, #000);
    padding-bottom: 1px;
    width: fit-content;
  }

  .pcp-address {
    font-style: normal;
    font-family: var(--font-hero);
    font-size: 1rem;
    color: var(--pcp-muted);
    display: flex;
    flex-direction: column;
    gap: 1px;
    margin-top: 2px;
  }
  .pcp-town { display: flex; gap: 0.4em; }

  .pcp-loc {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: 1px;
  }
  .pcp-loc span {
    font-family: var(--font-extra);
    font-size: 1rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #000;
    padding: 0.25em 0.45em;
    border: 1px solid #000;
    border-bottom-width: 4px;
    background: color-mix(in srgb, var(--loc-color, #888) 50%, transparent);
  }

  .pcp-slogans {
    list-style: none;
    margin: 8px 0 0;
    padding: 10px 0 0;
    border-top: 1px solid rgba(66, 64, 60, 0.25);
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  .pcp-slogans li {
    display: flex;
    gap: 9px;
    align-items: baseline;
    font-family: var(--font-label);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--pcp-ink2);
  }
  .pcp-slogans li::before {
    content: "◆";
    color: var(--pcp-accent);
    font-size: 9px;
  }

  .pcp-day { color: var(--pcp-muted); }
  .pcp-time { color: var(--pcp-ink2); }

  .pcp-phone-label {
    font-family: var(--font-label);
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    opacity: 0.6;
  }
  .pcp-phone-num { font-family: var(--font-hero); font-size: 15px; }

  .pcp-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 0.9em 1.2em 0.75em;
    background: var(--pcp-cream);
    color: var(--pcp-ink);
    border: 1px solid #000;
    transition: background-color 0.2s ease;
  }
  .pcp-btn:hover { background: var(--pcp-sand); }
  .pcp-btn .arrow { font-size: 14px; line-height: 0; }

  /* ---------- WEB layout — left content + right sidebar ---------- */
  .pcp-web {
    display: flex;
    flex-direction: row;
    align-items: stretch;
    background: azure;
    border: 12px solid var(--pcp-line);
    box-shadow: rgba(0, 0, 0, 0.2) 0 -3px 30px inset, rgba(0, 0, 0, 0.18) 0 8px 22px;
    overflow: hidden;
    position: relative;
    transition: box-shadow 0.2s ease;
  }
  .pcp-web:hover {
    box-shadow: rgba(0, 0, 0, 0.22) 0 -3px 30px inset, rgba(0, 0, 0, 0.26) 0 14px 34px;
  }

  .pcp-main {
    position: relative;
    flex: 1 1 auto;
    min-width: 0;
    padding: 30px 34px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .pcp-info {
    flex: 0 1 auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  /* Logo pinned to the top-right corner of the left column, at title height. */
  .pcp-logo--corner {
    position: absolute;
    top: 30px;
    right: 34px;
    width: 200px;
    height: 110px;
    display: flex;
    align-items: flex-start;
    justify-content: flex-end;
  }
  /* Keep title/category clear of the corner logo (address group sits below). */
  .pcp-main .pcp-cat-row,
  .pcp-main .pcp-name {
    padding-right: 200px;
  }

  /* Right sidebar — ~20%, footer-colored. */
  .pcp-side {
    flex: 0 0 20%;
    min-width: 220px;
    background: var(--pcp-ink);
    color: var(--pcp-cream);
    padding: 26px 22px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .pcp-side-phone {
    display: flex;
    flex-direction: column;
    gap: 2px;
    text-decoration: none;
    color: var(--pcp-cream);
  }
  .pcp-side-phone:hover { opacity: 0.75; }
  .pcp-side-phone .pcp-phone-num { font-size: 17px; }

  /* Desktop: actions stacked vertically in the narrow sidebar. */
  .pcp-side-actions {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .pcp-side-btn {
    width: 100%;
    justify-content: space-between;
  }

  .pcp-side-hours { margin-top: 4px; }
  .pcp-side-label {
    font-family: var(--font-label);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--pcp-cream);
    opacity: 0.65;
    margin-bottom: 7px;
  }
  .pcp-side-hours-list {
    display: flex;
    flex-direction: column;
    gap: 3px;
    font-family: var(--font-hero);
    font-size: 12px;
  }
  .pcp-side-hours-list > div {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    border-bottom: 1px dotted rgba(255, 250, 243, 0.2);
    padding-bottom: 2px;
  }
  .pcp-side-hours-list .pcp-day { color: rgba(255, 250, 243, 0.6); }
  .pcp-side-hours-list .pcp-time { color: var(--pcp-cream); }
  .pcp-side-dates {
    font-family: var(--font-heading);
    font-size: 15px;
    font-weight: 700;
    color: var(--pcp-cream);
    line-height: 1.3;
  }

  /* ---------- Mobile: stack the two columns, center everything ---------- */
  @media screen and (max-width: 850px) {
    .pcp-web {
      flex-direction: column;
    }

    .pcp-main {
      padding: 24px 22px 26px;
      align-items: center;
      text-align: center;
    }
    /* Logo no longer pinned to the corner — sits under the title, centered.
       Explicit order keeps it between the title and the address group. */
    .pcp-main .pcp-cat-row { order: 1; }
    .pcp-main .pcp-name { order: 2; }
    .pcp-logo--corner {
      position: static;
      width: 100%;
      height: auto;
      justify-content: center;
      margin: 4px 0;
      order: 3;
    }
    .pcp-logo--corner img { max-height: 90px; }
    .pcp-main .pcp-info { order: 4; }
    .pcp-main .pcp-slogans { order: 5; }
    /* Title/category reclaim full width (no corner logo to clear). */
    .pcp-main .pcp-cat-row,
    .pcp-main .pcp-name {
      padding-right: 0;
    }
    .pcp-name { font-size: 8vw; }

    /* Center the inner groups (they default to left-aligned columns). */
    .pcp-info { align-items: center; }
    .pcp-wine,
    .pcp-loc { justify-content: center; }
    .pcp-address { align-items: center; text-align: center; }
    .pcp-slogans { align-items: center; }
    .pcp-slogans li { justify-content: center; }

    /* Sidebar drops below content, full width, same footer color. */
    .pcp-side {
      flex-basis: auto;
      width: 100%;
      min-width: 0;
      padding: 20px 22px;
      align-items: center;
      text-align: center;
    }
    .pcp-side-phone { align-items: center; }
    .pcp-side-hours { text-align: center; }
    .pcp-side-hours-list { display: inline-flex; }

    /* Profile + website buttons side by side, until it gets too tight. */
    .pcp-side-actions {
      display: flex;
      flex-direction: row;
      gap: 10px;
      width: 100%;
    }
    .pcp-side-actions .pcp-btn { flex: 1; }
  }

  @media screen and (max-width: 550px) {
    .pcp-side-actions {
      flex-direction: column;
    }
  }
</style>
